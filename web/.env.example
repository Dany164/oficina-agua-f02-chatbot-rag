# Variables solo de servidor: no usar el prefijo NEXT_PUBLIC_.
# Copiar a web/.env.local para cambiarlas.
CHATBOT_API_URL=http://localhost:8080
CHATBOT_TIMEOUT_MS=30000
BFF_RATE_LIMIT_MAX_REQUESTS=10
BFF_RATE_LIMIT_WINDOW_SECONDS=60
# Solo true si el BFF está detrás de UN proxy de confianza que añade X-Forwarded-For.
BFF_TRUST_PROXY_HEADERS=false
